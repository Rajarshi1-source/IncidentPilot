# Environment — never commit real secrets. .env.example is the tracked template.
.env
.env.*
!.env.example

# Node (dashboard, W8)
node_modules/
.next/
out/

# Local scratch
*.log

# Generated by `make eval-gate` / the CI eval job. The report is an artifact
# and a sticky PR comment, never a committed file -- a checked-in copy would go
# stale the first time the corpus moved and then be read as if it had not.
eval-report.md
eval-metrics.json

# Next.js (dashboard)
dashboard/node_modules/
dashboard/.next/
dashboard/out/
dashboard/next-env.d.ts
*.tsbuildinfo
