# Copy to .env only if you want to override a default.
#
# You do NOT need this file to run the demo. `docker compose up` works on a
# clean clone with no .env at all -- every value below has a working default and
# the chat, metrics and LLM providers default to fake adapters (C-02).

# --- host ports ---------------------------------------------------------------
# Defaults live outside the usual ranges on purpose. This machine runs several
# capstone projects side by side, and 5432 (a local PostgreSQL install), 8000
# and 3000 (TraceMap containers) were already taken. Only the published host
# port moves -- inside the compose network the services still use 5432/6379.
IP_PORT_API=18000
IP_PORT_POSTGRES=55432
IP_PORT_VALKEY=56379
IP_PORT_PROMETHEUS=19090
IP_PORT_ALERTMANAGER=19093

# --- environment -------------------------------------------------------------
# dev|local|test relax the startup invariant checks. Anything else requires all
# three webhook secrets to be set (config/assert_invariants.py).
IP_ENVIRONMENT=local

# --- providers ---------------------------------------------------------------
# fake | slack
CHAT_PROVIDER=fake
# fake | prometheus
METRICS_PROVIDER=fake
# static | pagerduty
PAGING_PROVIDER=static

# --- trust boundary ----------------------------------------------------------
# Alertmanager CANNOT sign its payloads -- there is no HMAC option in
# http_config. This bearer plus mTLS plus a NetworkPolicy is the trust model.
ALERTMANAGER_BEARER=local-dev-token

# The paging provider signs with HMAC-SHA256 and may send several signatures
# during key rotation; all are accepted.
PAGING_WEBHOOK_SECRET=local-dev-paging-secret

# Slack signs with v0 HMAC over the raw body, within a 300s replay window.
SLACK_SIGNING_SECRET=dev-not-a-real-secret
SLACK_BOT_TOKEN=xoxb-fake-for-demo

# Socket Mode is a DEVELOPMENT transport: it opens an outbound WebSocket, so a
# laptop needs no public URL and no tunnel. It also has no signature to verify
# and no network boundary in front of it, so the runner refuses to start outside
# a dev environment. Production uses the signed HTTP receiver at
# /webhooks/slack/events.
# IP_SLACK_SOCKET_MODE=true
# IP_SLACK_APP_TOKEN=xapp-your-app-level-token

# --- transcript and reconciliation (W4) --------------------------------------
# Slack gives a non-Marketplace app ONE conversations.history call per minute,
# workspace-wide, and 15 messages per call. Lower this only if the app is
# Marketplace-approved -- never to make a demo look faster.
IP_HISTORY_BUDGET_PERIOD_S=60
IP_RECONCILE_INTERVAL_S=900

# --- governance --------------------------------------------------------------
IP_REDACT_PII=true
IP_LLM_BUDGET_USD_PER_INCIDENT=0.50
IP_LLM_BUDGET_USD_PER_DAY=5.0
